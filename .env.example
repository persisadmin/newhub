# --- Core ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32+-char-random-string
# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=persis
# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Pricing engine ---
PRICE_OFF_BENCHMARK_THRESHOLD_PCT=25
PRICE_MATCH_CONFIDENCE_THRESHOLD=0.6
PRICE_HYBRID_STRATEGY=weighted_average
PRICE_HYBRID_CONTRACTOR_WEIGHT=0.6
# --- Uploads ---
UPLOAD_MAX_BYTES=20971520
# --- Touch 'n Go payment provider ---
TNG_PROVIDER=mock            # mock | production gateway adapter
TNG_MERCHANT_ID=
TNG_WEBHOOK_SECRET=replace-with-webhook-secret
TNG_MOCK_AUTO_VERIFY=false

# --- CHIP In Asia (CHIP Collect) — the live processor: FPX + DuitNow QR ---
# Credentials come from the CHIP merchant portal (portal.chip-in.asia):
#   CHIP_SECRET_KEY — Collect → Developers → API keys → Secret key (test or live)
#   CHIP_BRAND_ID   — Collect → Settings  → Brand ID (UUID)
# No dashboard URL setup is needed: return + callback URLs are sent per-purchase,
# but NEXTAUTH_URL must be your real domain (https://www.persis.site) — with no
# explicit port, or CHIP rejects the success_callback.
# Use a TEST mode key first; a dummy payment page won't hit a real bank.
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
# Optional overrides (leave unset in normal operation):
# CHIP_BASE_URL=https://gate.chip-in.asia/api/v1   # sandbox endpoint, if any
# CHIP_PUBLIC_KEY=...PEM...                         # pin the callback key instead of fetching it
# CHIP_FPX_METHODS=fpx                              # add fpx_b2b1 for business banking
# CHIP_DUITNOW_METHODS=duitnow_qr

# --- PayHalal hosted gateway (FPX / cards / e-wallets) ---
# Keys come from merchant.payhalal.my -> Developer Tools -> Create App.
# In that app set:
#   Website URL        = https://your-domain
#   URL after Purchase = https://your-domain/api/payments/payhalal/redirect
#   Callback URL       = https://your-domain/api/payments/payhalal/notifications
# IMPORTANT: this is the dashboard's "App Key" (app-live-... or app-testing-...),
# NOT its "App ID" field. The app_id request parameter takes the KEY value.
PAYHALAL_APP_ID=
# The matching "Secret" (secret-...). Keep the "secret-" prefix.
PAYHALAL_APP_SECRET=
# Optional: only used by the reconciliation API; usually the same as the app key.
PAYHALAL_APP_KEY=
# Merchant email registered with PayHalal (used for reconciliation).
PAYHALAL_MERCHANT_ID=
# Optional: live | uat. When unset it is inferred from the app key
# (app-live-... -> live, app-testing-... -> uat testing endpoints).
PAYHALAL_MODE=

# LLM extraction providers (optional — configure via Admin Settings instead)
KIMI_API_KEY=
DASHSCOPE_API_KEY=

# Strategy briefing TTS (Google Gemini — uses the existing GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# --- DuitNow QR bridge (TNG merchant, phone-notification reconciliation) ---
# Preferred: paste the decoded payload string of your existing static merchant QR
# (decode a screenshot of your TNG merchant QR with any offline QR reader).
DUITNOW_STATIC_QR=
# Fallback (from-scratch QR) — values from the TNG merchant portal:
DUITNOW_ACQUIRER_ID=
DUITNOW_QR_ID=
DUITNOW_MERCHANT_NAME=
DUITNOW_MERCHANT_CITY=
# Shared secret for the MacroDroid -> /api/payments/notify bridge
PAYMENT_NOTIFY_SECRET=

# --- Transactional email (Resend) ---
# Get a key at https://resend.com — without it, emails are logged server-side only.
RESEND_API_KEY=
# Sender address. Use onboarding@resend.dev for testing; verify your domain for production.
EMAIL_FROM=PERSIS <onboarding@resend.dev>
