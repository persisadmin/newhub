# --- Core ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32+-char-random-string
# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=persis
# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Pricing engine ---
PRICE_OFF_BENCHMARK_THRESHOLD_PCT=25
PRICE_MATCH_CONFIDENCE_THRESHOLD=0.6
PRICE_HYBRID_STRATEGY=weighted_average
PRICE_HYBRID_CONTRACTOR_WEIGHT=0.6
# --- Uploads ---
UPLOAD_MAX_BYTES=20971520
# --- Touch 'n Go payment provider ---
TNG_PROVIDER=mock            # mock | production gateway adapter
TNG_MERCHANT_ID=
TNG_WEBHOOK_SECRET=replace-with-webhook-secret
TNG_MOCK_AUTO_VERIFY=false

# LLM extraction providers (optional — configure via Admin Settings instead)
KIMI_API_KEY=
DASHSCOPE_API_KEY=

# Strategy briefing TTS (Google Gemini — uses the existing GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# --- DuitNow QR bridge (TNG merchant, phone-notification reconciliation) ---
# Preferred: paste the decoded payload string of your existing static merchant QR
# (decode a screenshot of your TNG merchant QR with any offline QR reader).
DUITNOW_STATIC_QR=
# Fallback (from-scratch QR) — values from the TNG merchant portal:
DUITNOW_ACQUIRER_ID=
DUITNOW_QR_ID=
DUITNOW_MERCHANT_NAME=
DUITNOW_MERCHANT_CITY=
# Shared secret for the MacroDroid -> /api/payments/notify bridge
PAYMENT_NOTIFY_SECRET=
